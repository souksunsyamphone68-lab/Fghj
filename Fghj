-- 🛠️ Helper Functions สำหรับ Oil Drum Scanner
local function warpToPosition(position)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart then
        humanoidRootPart.CFrame = CFrame.new(position)
        task.wait(0.3)
    end
end

local function findOilDrumModel(position, radius)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("oil") or obj.Name:lower():find("drum") or obj.Name:lower():find("barrel")) then
            local primaryPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primaryPart then
                local distance = (primaryPart.Position - position).Magnitude
                if distance <= radius then
                    return true, obj.Name
                end
            end
        end
    end
    return false, nil
end

local function scanAllDrums()
    print("========================================")
    print("🔍 เริ่มสแกนถังน้ำมันทั้งหมดบน map...")
    print("========================================")
    
    local results = { found = {}, stolen = {} }
    
    for i, location in ipairs(oilDrumLocations) do
        if not getgenv().OilScanLoopEnabled then break end
        
        print(string.format("\n📍 [%d/%d] ไปที่: %s", i, #oilDrumLocations, location.name))
        warpToPosition(location.position)
        task.wait(0.5)
        
        local found, drumName = findOilDrumModel(location.position, 20)
        
        if found then
            table.insert(results.found, { name = location.name, modelName = drumName })
            print(string.format("   ✅ พบถังน้ำมัน: %s", drumName or "Unknown"))
        else
            table.insert(results.stolen, { name = location.name })
            print(string.format("   ❌ ถังน้ำมันหายไป / โดนขโมยไปแล้ว!"))
        end
        
        task.wait(0.2)
    end
    
    print("\n📊 สรุปผลการตรวจเช็ค:")
    print(string.format("✅ พบ: %d จุด | ❌ หาย/ถูกขโมย: %d จุด", #results.found, #results.stolen))
    print("========================================\n")
end

-- 6. ฟังก์ชันค้นหาผู้เล่นใกล้ที่สุด (ข้ามคนที่มีเกราะอมตะ / ForceField)
local function getClosestPlayer()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local rootPart = character.HumanoidRootPart
    local closestPlayer = nil
    local shortestDistance = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
            local hasForceField = player.Character:FindFirstChildOfClass("ForceField") or player.Character:FindFirstChild("ForceField")
            
            if player.Character:FindFirstChildOfClass("Humanoid").Health > 0 and not hasForceField then
                local distance = (rootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- ==================== 7. ระบบ Real-time Player Overlay & Tracers ====================
local function createOverlay(player)
    if player == LocalPlayer then return end
    local text = Drawing.new("Text")
    text.Color = Color3.fromRGB(255, 255, 0)
    text.Size = 13
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Visible = false
    Overlays[player] = text
end

local function removeOverlay(player)
    if Overlays[player] then
        Overlays[player]:Remove()
        Overlays[player] = nil
    end
end

local function createTracer(player)
    if player == LocalPlayer then return end
    local line = Drawing.new("Line")
    line.Color = Color3.fromRGB(255, 0, 0)
    line.Thickness = 1.5
    line.Transparency = 1
    line.Visible = false

    local text = Drawing.new("Text")
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Size = 13
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Visible = false

    Tracers[player] = {Line = line, Text = text}
end

local function removeTracer(player)
    if Tracers[player] then
        if Tracers[player].Line then Tracers[player].Line:Remove() end
        if Tracers[player].Text then Tracers[player].Text:Remove() end
        Tracers[player] = nil
    end
end

for _, player in pairs(Players:GetPlayers()) do 
    createTracer(player) 
    createOverlay(player)
end

Players.PlayerAdded:Connect(function(p) createTracer(p); createOverlay(p) end)
Players.PlayerRemoving:Connect(function(p) removeTracer(p); removeOverlay(p) end)

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for player, overlayText in pairs(Overlays) do
        if getgenv().PlayerOverlayEnabled and myHrp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
            local targetChar = player.Character
            local targetHrp = targetChar.HumanoidRootPart
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

            if targetHum.Health > 0 then
                local head = targetChar:FindFirstChild("Head") or targetHrp
                local screenPos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2, 0))

                if onScreen then
                    local distance = math.floor((myHrp.Position - targetHrp.Position).Magnitude)
                    local heldTool = "None"
                    local toolObj = targetChar:FindFirstChildOfClass("Tool")
                    if toolObj then heldTool = toolObj.Name end

                    overlayText.Position = Vector2.new(screenPos.X, screenPos.Y)
                    overlayText.Text = string.format("👤 %s | 🩸 %d/%d HP | ⚡ SPD: %d | 📏 %dm | 🗡️ %s",
                        player.Name, math.floor(targetHum.Health), math.floor(targetHum.MaxHealth), math.floor(targetHum.WalkSpeed), distance, heldTool)
                    overlayText.Visible = true
                else
                    overlayText.Visible = false
                end
            else
                overlayText.Visible = false
            end
        else
            overlayText.Visible = false
        end
    end

    for player, tracerData in pairs(Tracers) do
        local line, text = tracerData.Line, tracerData.Text
        if getgenv().TracersEnabled and myHrp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
            local targetHrp = player.Character.HumanoidRootPart
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")

            if targetHum.Health > 0 then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetHrp.Position)
                if onScreen then
                    local distance = math.floor((myHrp.Position - targetHrp.Position).Magnitude)
                    line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    line.To = Vector2.new(screenPos.X, screenPos.Y)
                    line.Visible = true

                    text.Position = Vector2.new(screenPos.X, screenPos.Y - 20)
                    text.Text = player.Name .. " [" .. tostring(distance) .. "m]"
                    text.Visible = true
                else
                    line.Visible = false; text.Visible = false
                end
            else
                line.Visible = false; text.Visible = false
            end
        else
            line.Visible = false; text.Visible = false
        end
    end
end)

