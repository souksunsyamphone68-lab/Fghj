task.spawn(function()
    while task.wait(0.05) do
        if (getgenv().AutoShootEnabled or getgenv().AutoKillLoopEnabled) and LocalPlayer.Character then
            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        if getgenv().AutoKillLoopEnabled then
            local target = getClosestPlayer()
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChildOfClass("Humanoid") then
                local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
                local targetHrp = target.Character.HumanoidRootPart

                while targetHum and targetHum.Health > 0 and getgenv().AutoKillLoopEnabled and target.Parent do
                    if target.Character and (target.Character:FindFirstChildOfClass("ForceField") or target.Character:FindFirstChild("ForceField")) then
                        break
                    end

                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    
                    if myHrp and targetHrp then
                        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
                        workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, targetHrp.Position)
                    end
                    task.wait(0.03)
                end
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if getgenv().SpeedEnabled then humanoid.WalkSpeed = getgenv().WalkSpeedValue end
        if getgenv().JumpEnabled then humanoid.UseJumpPower = true; humanoid.JumpPower = getgenv().JumpPowerValue end
    end

    if getgenv().InfAmmoEnabled and LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, attrName in pairs({"Ammo", "Clip", "MaxAmmo", "StoredAmmo", "Bullets"}) do
                if tool:GetAttribute(attrName) then tool:SetAttribute(attrName, 999) end
            end
            for _, v in pairs(tool:GetDescendants()) do
                if v:IsA("IntValue") or v:IsA("NumberValue") then
                    local nameLower = string.lower(v.Name)
                    if string.find(nameLower, "ammo") or string.find(nameLower, "clip") then
                        v.Value = 999
                    end
                end
            end
        end
    end
end)

